# Postgres connection string. In the Vercel dashboard: Storage tab →
# Create Database → Postgres (Neon) → Connect to Project. This env var is
# then injected automatically — you don't need to copy/paste it yourself,
# this file is just documentation.
DATABASE_URL=

# Vercel Blob (file storage). In the Vercel dashboard: Storage tab →
# Create Database → Blob → Connect to Project. Also injected automatically
# once connected.
BLOB_READ_WRITE_TOKEN=
