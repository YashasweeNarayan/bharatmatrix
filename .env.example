# Postgres connection string. In the Vercel dashboard: Storage tab →
# Create Database → Postgres (Neon) → Connect to Project. This env var is
# then injected automatically — you don't need to copy/paste it yourself,
# this file is just documentation.
DATABASE_URL=

# Vercel Blob (file storage). In the Vercel dashboard: Storage tab →
# Create Database → Blob → Connect to Project. Also injected automatically
# once connected. Make sure "Add a read-write token env var to this
# connection" is checked when creating it, or this var won't be created.
BLOB_READ_WRITE_TOKEN=

# Gemini API key, for embeddings + question-answering. Get one free at
# https://aistudio.google.com/apikey, then add it in Vercel: Settings →
# Environment Variables → New → name GEMINI_API_KEY, paste the key, apply
# to Production and Preview.
GEMINI_API_KEY=
